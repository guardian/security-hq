#!/usr/bin/env bash

set -e

DIR=$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )
ROOT_DIR="${DIR}/.."
cd $ROOT_DIR

case "${1}" in
  iam-outdated-credentials)
    shift
    sbt "iamOutdatedCredentials / run $@"
    ;;
  *)
    echo "Usage: $(basename "$0") iam-outdated-credentials \"<stack> <stage> <dryRunFlag> <configBucket> <configKey>\"" >&2
    exit 1
    ;;
esac
